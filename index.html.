<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COFICAB - Tool & Die Shop System</title>
    <!-- QRCode.js Library -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <style>
        :root {
            --primary: #0284c7;
            --primary-dark: #0369a1;
            --bg-dark: #0f172a;
            --card-bg: #1e293b;
            --text-light: #f8fafc;
            --text-muted: #94a3b8;
            --border-color: #334155;
            --accent: #38bdf8;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--text-light);
            padding: 15px;
            max-width: 900px;
            margin: 0 auto;
        }

        /* COFICAB Header Banner */
        .coficab-header-banner {
            position: relative;
            width: 100%;
            height: 190px;
            background: linear-gradient(135deg, rgba(15, 23, 42, 0.75), rgba(30, 41, 59, 0.85)), 
                        url('410756.jpg') center/cover no-repeat;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid var(--border-color);
        }

        .banner-overlay {
            text-align: center;
            color: #ffffff;
            padding: 20px;
        }

        .brand-logo {
            font-size: 1.2rem;
            font-weight: 800;
            letter-spacing: 4px;
            color: var(--accent);
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .banner-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0;
            color: #ffffff;
        }

        .banner-subtitle {
            font-size: 0.9rem;
            margin-top: 6px;
            color: var(--text-muted);
        }

        /* Search Section */
        .search-box {
            margin-bottom: 20px;
        }

        .search-input {
            width: 100%;
            padding: 14px 18px;
            font-size: 1rem;
            border-radius: 12px;
            border: 2px solid var(--border-color);
            background-color: var(--card-bg);
            color: var(--text-light);
            outline: none;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 12px rgba(56, 189, 248, 0.3);
        }

        /* Inventory Cards */
        .results-container {
            display: grid;
            gap: 12px;
            margin-bottom: 30px;
        }

        .item-card {
            background-color: var(--card-bg);
            border-radius: 12px;
            padding: 16px;
            border: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
        }

        .item-info {
            flex: 1;
            min-width: 200px;
        }

        .item-title {
            font-size: 1.1rem;
            font-weight: bold;
            color: var(--accent);
            margin-bottom: 4px;
        }

        .item-details {
            font-size: 0.88rem;
            color: var(--text-muted);
            line-height: 1.5;
        }

        .badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.82rem;
            font-weight: bold;
        }

        .badge-locker {
            background-color: rgba(2, 132, 199, 0.2);
            color: #38bdf8;
            border: 1px solid rgba(56, 189, 248, 0.4);
        }

        .badge-cabinet {
            background-color: rgba(234, 179, 8, 0.2);
            color: #facc15;
            border: 1px solid rgba(250, 204, 21, 0.4);
        }

        /* QR Code Section */
        .qr-section {
            background-color: var(--card-bg);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            border: 1px solid var(--border-color);
            margin-top: 20px;
        }

        .qr-title {
            font-size: 1.1rem;
            color: var(--text-light);
            margin-bottom: 12px;
            font-weight: bold;
        }

        #qrcode {
            display: flex;
            justify-content: center;
            margin: 15px 0;
        }

        #qrcode img {
            border: 6px solid #ffffff;
            border-radius: 8px;
        }

        .qr-desc {
            font-size: 0.85rem;
            color: var(--text-muted);
        }

        .no-results {
            text-align: center;
            padding: 30px;
            color: var(--text-muted);
            background-color: var(--card-bg);
            border-radius: 12px;
        }
    </style>
</head>
<body>

    <!-- Header Banner -->
    <div class="coficab-header-banner">
        <div class="banner-overlay">
            <div class="brand-logo">COFICAB</div>
            <h1 class="banner-title">Tool & Die Shop System</h1>
            <p class="banner-subtitle">نظام البحث وإدارة دايات وأدوات الورشة</p>
        </div>
    </div>

    <!-- Search Input -->
    <div class="search-box">
        <input type="text" id="searchInput" class="search-input" placeholder="🔍 ابحث باسم الأداة، الكود، الرف، أو المكان (مثال: Locker E / Cabinet E)..." onkeyup="filterItems()">
    </div>

    <!-- Inventory Items Container -->
    <div id="resultsContainer" class="results-container"></div>

    <!-- QR Code Section -->
    <div class="qr-section">
        <div class="qr-title">📱 رمز الوصول السريع للورشة (QR Code)</div>
        <div id="qrcode"></div>
        <p class="qr-desc">امسح الرمز بالموبايل للوصول المباشر لقاعدة بيانات الورشة</p>
    </div>

    <script>
        // Database Array
        const inventoryData = [
            // Locker E (Dies) vs Cabinet E (Tools) Separation
            { name: "Multi Drawing Dies Set (دايات السحب المزدوج)", location: "Locker E", shelf: "Shelf 1-2", category: "Dies", type: "locker" },
            { name: "Extrusion Maintenance Tools & Accessories (أدوات الصيانة)", location: "Cabinet E", shelf: "Shelf 1-4", category: "Tools", type: "cabinet" },
            
            // Other Lockers & Lines
            { name: "Bunching Dies (دايات التجميع)", location: "Locker D", shelf: "Shelf 1-3", category: "Dies", type: "locker" },
            { name: "Multi Drawing Dies - Extra (دايات سحب إضافية)", location: "Locker F", shelf: "Shelf 1-2", category: "Dies", type: "locker" },
            { name: "Ceramics & Cable Guides (سيراميك وموجهات)", location: "Locker A", shelf: "Shelf 1-2", category: "Ceramics", type: "locker" },
            { name: "HPC-15 Filter Boxes & Spare Parts (فلاتر ومكونات)", location: "Locker B", shelf: "Shelf 1-3", category: "Filters", type: "locker" },
            { name: "Tapes, Sponges & Screws (أشرطة وإسفنج ومسامير)", location: "Locker C", shelf: "Shelf 1-4", category: "Accessories", type: "locker" },
            { name: "ROD Line Dies & Extrusion Lines (خط السحب والكبس)", location: "ROD / Extrusion Lines", shelf: "Main Rack", category: "Extrusion", type: "locker" }
        ];

        // Render Inventory Function
        function renderItems(data) {
            const container = document.getElementById('resultsContainer');
            container.innerHTML = '';

            if (data.length === 0) {
                container.innerHTML = '<div class="no-results">عذراً، لم يتم العثور على أي أدوات أو دايات مطابقة للبحث.</div>';
                return;
            }

            data.forEach(item => {
                const badgeClass = item.type === 'cabinet' ? 'badge-cabinet' : 'badge-locker';
                const cardHtml = `
                    <div class="item-card">
                        <div class="item-info">
                            <div class="item-title">${item.name}</div>
                            <div class="item-details">
                                📍 المكان: <strong>${item.location}</strong> | 🗄️ الرف: <strong>${item.shelf}</strong><br>
                                📦 التصنيف: ${item.category}
                            </div>
                        </div>
                        <div>
                            <span class="badge ${badgeClass}">${item.location}</span>
                        </div>
                    </div>
                `;
                container.innerHTML += cardHtml;
            });
        }

        // Filter Function
        function filterItems() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const filtered = inventoryData.filter(item => 
                item.name.toLowerCase().includes(query) ||
                item.location.toLowerCase().includes(query) ||
                item.shelf.toLowerCase().includes(query) ||
                item.category.toLowerCase().includes(query)
            );
            renderItems(filtered);
        }

        // Initial Render
        renderItems(inventoryData);

        // Dynamic QR Code Generation
        const siteUrl = "https://hassanyaman53-cyber.github.io/Tool-Shoop-coficab/";
        new QRCode(document.getElementById("qrcode"), {
            text: siteUrl,
            width: 140,
            height: 140,
            colorDark : "#000000",
            colorLight : "#ffffff",
            correctLevel : QRCode.CorrectLevel.H
        });
    </script>
</body>
</html>
